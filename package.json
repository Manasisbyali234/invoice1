{
  "name": "invoice-copy-manager",
  "version": "1.0.0",
  "description": "Invoice Copy Manager Application",
  "author": "Invoice Manager",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "server": "node server/server.js",
    "dev": "concurrently -k \"node server/server.js\" \"vite\"",
    "electron:dev": "concurrently -k \"node server/server.js\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.invoice.manager",
    "productName": "Invoice Manager",
    "executableName": "Invoice Manager",
    "directories": {
      "output": "C:\\invoice-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/@pdf-lib/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/@pdf-lib/**/*",
      "electron/bin/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.395.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^9.1.0"
  }
}
